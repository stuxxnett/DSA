//brute force
class Solution {
    public int[] buildArray(int[] nums) {
        int[] ans = new int[nums.length];
        for(int i = 0; i<nums.length; i++) {
            ans[i] = nums[nums[i]];
        }
        return ans;
    }
}

// recursive solution
class Solution {
    public int[] buildArray(int[] nums) {
        permutation(nums, 0);
        return nums;
    }
    static void permutation(int[] nums, int i) {
        if(i==nums.length) {
            return;
        }
        int element = nums[nums[i]];
        permutation(nums,i+1);
        nums[i] = element;
    }
}
